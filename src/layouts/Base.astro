---
import '@fontsource-variable/big-shoulders/opsz.css';
import '@fontsource-variable/big-shoulders-stencil/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-mono/wght.css';
import '../styles/global.css';
import displayFont from '@fontsource-variable/big-shoulders/files/big-shoulders-latin-opsz-normal.woff2?url';
import bodyFont from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, cleanPath } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  /** Where the header's Subscribe button points on this page. */
  subscribeHref?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  imageAlt = 'Students at a Bridge AIDE workshop on ethical principles in AI.',
  subscribeHref = '#subscribe',
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(cleanPath(Astro.url.pathname), SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bridgeaide" />

    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f1f5fa" />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      try {
        const saved = localStorage.getItem('print');
        if (saved === 'blueprint' || saved === 'whiteprint') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>

    {ld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- Photographic print processes: luminance mapped to cyanotype / diazo ink. -->
    <svg class="print-filters" aria-hidden="true" focusable="false" width="0" height="0">
      <filter id="print-blueprint" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0 0 0 1 0"
        ></feColorMatrix>
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.03 0.13 0.42 0.93"></feFuncR>
          <feFuncG type="table" tableValues="0.11 0.3 0.6 0.955"></feFuncG>
          <feFuncB type="table" tableValues="0.22 0.5 0.8 0.98"></feFuncB>
        </feComponentTransfer>
      </filter>
      <filter id="print-whiteprint" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0 0 0 1 0"
        ></feColorMatrix>
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.06 0.2 0.55 0.945"></feFuncR>
          <feFuncG type="table" tableValues="0.18 0.35 0.68 0.96"></feFuncG>
          <feFuncB type="table" tableValues="0.33 0.55 0.82 0.98"></feFuncB>
        </feComponentTransfer>
      </filter>
    </svg>

    <Header subscribeHref={subscribeHref} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Section rules draw left to right as they enter the sheet.
      const targets = document.querySelectorAll<HTMLElement>('[data-draw-group]');
      const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
      if (motionOK && 'IntersectionObserver' in window && targets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-drawn');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px' },
        );
        targets.forEach((el) => {
          const box = el.getBoundingClientRect();
          if (box.top > window.innerHeight) {
            el.classList.add('will-draw');
            io.observe(el);
          }
        });
      }
    </script>
  </body>
</html>

<style>
  .print-filters {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  main:focus {
    outline: none;
  }
</style>
