---
import Base from '../layouts/Base.astro';
import ReadSheet from '../components/ReadSheet.astro';
import { SITE } from '../data/site';

const sections = [
  { id: 'information-we-collect', title: 'Information We Collect' },
  { id: 'how-we-use-your-information', title: 'How We Use Your Information' },
  { id: 'cookies-and-tracking', title: 'Cookies and Tracking' },
  { id: 'youth-privacy-notice', title: 'Youth Privacy Notice' },
  { id: 'your-rights', title: 'Your Rights' },
  { id: 'data-storage', title: 'Data Storage' },
  { id: 'changes-to-this-policy', title: 'Changes to This Policy' },
];
const mail = `mailto:${SITE.email}?subject=${encodeURIComponent('Personal Information Inquiry')}`;
---

<Base
  title="Privacy Policy | Bridge AI Development and Ethics"
  description="Learn how Bridge AIDE collects, uses, and protects your information. We value transparency and your right to privacy."
  subscribeHref="/#subscribe"
>
  <ReadSheet title="Bridge AIDE Privacy Policy" meta="Effective Date: Sunday, October 11, 2026" sections={sections}>
    <p class="lead">
      Bridge AIDE values your privacy. This policy explains what personal information we collect through our website,
      how we use it, and what choices you have.
    </p>

    <h2 id="information-we-collect">Information We Collect</h2>
    <p>We collect personal information in two ways:</p>
    <ul>
      <li><strong>Mailing List Sign-Up:</strong> First name and email address</li>
      <li><strong>Event Registration:</strong> First name, last name, and email address</li>
    </ul>
    <p>
      Our website does not use analytics or advertising trackers. Like most websites, our hosting provider may
      automatically log basic technical information, such as IP address and browser type, to keep the site secure and
      running. If you sign up for our mailing list, your first name and email address are processed by the email
      service we use to send updates.
    </p>

    <h2 id="how-we-use-your-information">How We Use Your Information</h2>
    <p>We use the information you provide to:</p>
    <ul>
      <li>Send newsletters or updates (if you signed up for the mailing list)</li>
      <li>Manage event participation (if you registered for an event)</li>
    </ul>
    <p>We do not sell, trade, or share your personal information with third parties for marketing purposes.</p>

    <h2 id="cookies-and-tracking">Cookies and Tracking</h2>
    <p>
      Our website does not use cookies or tracking technologies. If you choose the Blueprint or Whiteprint display
      theme, that preference is saved only in your own browser and is never sent to us. You can clear it at any time
      through your browser settings.
    </p>

    <h2 id="youth-privacy-notice">Youth Privacy Notice</h2>
    <p>
      Some of our users may be under 18. We take special care to collect only the information necessary to provide
      services like event sign-up or newsletter communication. We do not knowingly collect more information than
      needed or target advertising based on age.
    </p>
    <p>If you are under 13, please obtain a parent or guardian’s permission before submitting your information.</p>

    <h2 id="your-rights">Your Rights</h2>
    <p>You can:</p>
    <ul>
      <li>Request access to your personal information</li>
      <li>Ask us to delete your information</li>
    </ul>
    <p>To do so, please email us at <a href={mail}>{SITE.email}</a>.</p>

    <h2 id="data-storage">Data Storage</h2>
    <p>Our site is hosted in the United States, and data is stored securely on servers based in the U.S.</p>

    <h2 id="changes-to-this-policy">Changes to This Policy</h2>
    <p>
      We may update this Privacy Policy as our organization grows or our services change. Updates will be posted here
      with a new effective date.
    </p>
  </ReadSheet>
</Base>
