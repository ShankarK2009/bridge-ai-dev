---
// Mailing-list sign-up laid out as a drawing's title block.
// `stacked` runs the cells vertically. `corner` is the hero's corner block:
// one ruled row on tablets, stacked in the sheet's corner from desktop up.
import { SITE } from '../data/site';

interface Props {
  id: string;
  variant?: 'stacked' | 'corner';
  heading?: string;
  headingLevel?: 'h2' | 'h3';
  /** Accessible name when the page has more than one sign-up form. */
  label?: string;
}

const {
  id,
  variant = 'stacked',
  heading = 'Join the Bridge AIDE Mailing List',
  headingLevel: Heading = 'h2',
  label,
} = Astro.props;
---

<form
  class:list={['tb', `tb--${variant}`]}
  data-subscribe
  data-endpoint={SITE.subscribeEndpoint}
  data-email={SITE.email}
  action={SITE.subscribeEndpoint || `mailto:${SITE.email}?subject=Mailing%20list%20sign-up`}
  method="post"
  enctype={SITE.subscribeEndpoint ? undefined : 'text/plain'}
  aria-labelledby={label ? undefined : `${id}-title`}
  aria-label={label}
>
  <div class="tb__cell tb__head">
    <Heading class="tb__title" id={`${id}-title`}>{heading}</Heading>
  </div>
  <div class="tb__cell field">
    <label class="annot" for={`${id}-first`}>
      First name <span aria-hidden="true">*</span><span class="visually-hidden">(required)</span>
    </label>
    <input
      class="input input--line"
      id={`${id}-first`}
      name="firstName"
      type="text"
      autocomplete="given-name"
      required
      aria-describedby={`${id}-first-err`}
    />
    <p class="field__error" id={`${id}-first-err`}></p>
  </div>
  <div class="tb__cell field">
    <label class="annot" for={`${id}-email`}>
      Email address <span aria-hidden="true">*</span><span class="visually-hidden">(required)</span>
    </label>
    <input
      class="input input--line"
      id={`${id}-email`}
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      spellcheck="false"
      required
      aria-describedby={`${id}-email-err`}
    />
    <p class="field__error" id={`${id}-email-err`}></p>
  </div>
  <div class="tb__cell tb__action">
    <button class="btn btn--red" type="submit" data-label="Subscribe">Subscribe</button>
  </div>
  <div class="tb__status" role="status" aria-live="polite" hidden>
    <span class="stamp" data-stamp></span>
    <p data-message></p>
  </div>
</form>

<style>
  .tb {
    display: grid;
    border: 2px solid var(--ink);
    background: var(--paper);
  }

  .tb__cell {
    padding: 1rem 1.125rem 1.125rem;
    min-width: 0;
  }

  .tb__title {
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
    font-weight: 750;
    line-height: 1.02;
  }

  .tb__action {
    display: flex;
    align-items: flex-end;
  }

  .tb__action .btn {
    width: 100%;
  }

  .input--line {
    border: 0;
    border-bottom: 1.5px solid var(--ink-2);
    background: var(--paper-2);
  }

  .input--line:hover,
  .input--line:focus-visible {
    border-bottom-color: var(--ink);
  }

  .input--line[aria-invalid='true'] {
    border-bottom-color: var(--red);
  }

  .tb__status {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    padding: 1.125rem;
    border-top: 1px solid var(--ink);
  }

  .tb__status[hidden] {
    display: none;
  }

  .tb__status p {
    font-weight: 600;
  }

  .tb.is-done .tb__cell:not(.tb__head) {
    display: none;
  }

  /* Stacked: one column of ruled cells */
  .tb--stacked .tb__cell + .tb__cell {
    border-top: 1px solid var(--ink);
  }

  /* Corner: stacked on phones and desktop, one ruled row on tablets */
  .tb--corner .tb__cell + .tb__cell {
    border-top: 1px solid var(--ink);
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .tb--corner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 1.25fr) auto;
    }

    .tb--corner .tb__cell + .tb__cell {
      border-top: 0;
      border-left: 1px solid var(--ink);
    }

    .tb--corner .tb__head {
      display: flex;
      align-items: center;
    }

    .tb--corner .tb__title {
      font-size: 1.375rem;
    }

    .tb--corner.is-done {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 3fr);
    }

    .tb--corner.is-done .tb__status {
      grid-column: auto;
      border-top: 0;
      border-left: 1px solid var(--ink);
    }
  }

  /* Desktop corner block: compact cells so the hero holds the fold at 1280x800. */
  @media (min-width: 1024px) {
    .tb--corner .tb__cell {
      padding: 0.75rem 1.125rem 0.875rem;
    }

    .tb--corner .tb__title {
      font-size: clamp(1.375rem, 0.9rem + 0.75vw, 1.75rem);
    }

    .tb--corner .field {
      gap: 0.375rem;
    }

    .tb--corner .input {
      min-height: 44px;
      padding-block: 0.5rem;
    }
  }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function setError(input: HTMLInputElement, message: string) {
    const error = document.getElementById(input.getAttribute('aria-describedby') ?? '');
    if (error) error.textContent = message;
    input.setAttribute('aria-invalid', message ? 'true' : 'false');
  }

  function validate(form: HTMLFormElement) {
    const first = form.elements.namedItem('firstName') as HTMLInputElement;
    const email = form.elements.namedItem('email') as HTMLInputElement;
    const firstMsg = first.value.trim() ? '' : 'Enter your first name.';
    const emailValue = email.value.trim();
    const emailMsg = !emailValue
      ? 'Enter your email address.'
      : EMAIL_RE.test(emailValue)
        ? ''
        : 'Enter an email address like name@example.com.';
    setError(first, firstMsg);
    setError(email, emailMsg);
    const firstInvalid = firstMsg ? first : emailMsg ? email : null;
    firstInvalid?.focus();
    return { ok: !firstInvalid, first: first.value.trim(), email: emailValue };
  }

  function showStatus(form: HTMLFormElement, stamp: string, message: string, done: boolean) {
    const status = form.querySelector<HTMLElement>('.tb__status')!;
    const stampEl = status.querySelector<HTMLElement>('[data-stamp]')!;
    stampEl.textContent = stamp;
    stampEl.hidden = !stamp;
    status.querySelector<HTMLElement>('[data-message]')!.textContent = message;
    status.hidden = false;
    form.classList.toggle('is-done', done);
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-subscribe]')) {
    form.noValidate = true;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') setError(input, '');
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const { ok, first, email } = validate(form);
      if (!ok) return;

      const endpoint = form.dataset.endpoint;
      const contact = form.dataset.email ?? '';

      if (!endpoint) {
        const subject = encodeURIComponent('Mailing list sign-up');
        const body = encodeURIComponent(
          `Please add me to the Bridge AIDE mailing list.\n\nFirst name: ${first}\nEmail: ${email}`,
        );
        window.location.href = `mailto:${contact}?subject=${subject}&body=${body}`;
        showStatus(form, '', `Your email app should open with your sign-up ready to send to ${contact}.`, false);
        return;
      }

      button.disabled = true;
      button.textContent = 'Sending';
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(String(response.status));
        showStatus(form, 'Received', `Thanks, ${first}. You’re on the Bridge AIDE mailing list.`, true);
        form.reset();
      } catch {
        showStatus(
          form,
          '',
          `We couldn’t add you just now. Please try again, or email ${contact}.`,
          false,
        );
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.label ?? 'Subscribe';
      }
    });
  }
</script>
