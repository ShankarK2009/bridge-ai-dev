---
import { SITE } from '../data/site';

interface Props {
  id: string;
  heading?: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  id,
  heading = 'Join the Bridge AIDE Mailing List',
  headingLevel: Heading = 'h2',
} = Astro.props;
---

<section class="signup" aria-labelledby={`${id}-title`}>
  <div class="signup__head">
    <Heading class="signup__title" id={`${id}-title`}>{heading}</Heading>
    <p>
      <a href={SITE.subscribeFormUrl} target="_blank" rel="noopener noreferrer">
        Open the form in a new tab
      </a>
    </p>
  </div>
  <iframe
    class="signup__embed"
    src={`${SITE.subscribeFormUrl}?embedded=true`}
    title="Bridge AIDE member signup form"
    width="640"
    height="640"
    loading="lazy"
  ></iframe>
</section>

<style>
  .signup {
    min-width: 0;
    border: 2px solid var(--ink);
    background: var(--paper);
  }

  .signup__head {
    padding: 1rem 1.125rem;
    border-bottom: 1px solid var(--ink);
  }

  .signup__title {
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
    font-weight: 750;
    line-height: 1.02;
  }

  .signup__head p {
    margin-top: var(--space-3);
  }

  .signup__embed {
    display: block;
    width: 100%;
    border: 0;
    background: #fff;
    color-scheme: light;
  }
</style>
