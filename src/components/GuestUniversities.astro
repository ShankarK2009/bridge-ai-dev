---
import Icon from './Icon.astro';
import { withBase } from '../data/site';

const universities = [
  { logo: 'carnegie-mellon', name: 'Carnegie Mellon University' },
  { logo: 'princeton', name: 'Princeton University' },
  { logo: 'uc-berkeley', name: 'UC Berkeley' },
  { logo: 'uc-santa-barbara', name: 'UC Santa Barbara' },
  { logo: 'ucla', name: 'UCLA', compact: true },
  { logo: 'minnesota-twin-cities', name: 'University of Minnesota Twin Cities' },
  { logo: 'usc', name: 'University of Southern California', compact: true },
];
---

<section class="section container" aria-labelledby="guest-universities-title" aria-roledescription="carousel">
  <div class="guest-universities__header">
    <div class="guest-universities__intro">
      <h2 id="guest-universities-title">Where Our Guest Professors Teach</h2>
      <p>Bridge AIDE has hosted professors from these universities or plans to welcome them at future events.</p>
    </div>
    <div class="guest-universities__controls" data-university-controls hidden>
      <button class="btn" type="button" aria-label="Previous university" aria-controls="guest-universities-logos" aria-disabled="true" data-university-previous>
        <Icon name="arrow-left" />
      </button>
      <button class="btn" type="button" aria-label="Next university" aria-controls="guest-universities-logos" data-university-next>
        <Icon name="arrow-right" />
      </button>
    </div>
  </div>
  <ul id="guest-universities-logos" class="guest-universities__track" role="list" aria-label="University logos" tabindex="0">
    {universities.map(({ logo, name, compact }) => (
      <li class:list={['guest-universities__slide', { 'guest-universities__slide--compact': compact }]}>
        <img src={withBase(`/images/universities/${logo}.webp`)} alt={name} loading="lazy" decoding="async" />
      </li>
    ))}
  </ul>
</section>

<script>
  const track = document.getElementById('guest-universities-logos');
  const controls = document.querySelector<HTMLElement>('[data-university-controls]');
  const previous = controls?.querySelector<HTMLButtonElement>('[data-university-previous]');
  const next = controls?.querySelector<HTMLButtonElement>('[data-university-next]');
  const firstSlide = track?.firstElementChild;

  if (track && controls && previous && next && firstSlide) {
    const updateControls = () => {
      const remaining = track.scrollWidth - track.clientWidth - track.scrollLeft;
      previous.setAttribute('aria-disabled', String(track.scrollLeft <= 1));
      next.setAttribute('aria-disabled', String(remaining <= 1));
    };

    previous.addEventListener('click', () => {
      if (previous.getAttribute('aria-disabled') !== 'true') {
        track.scrollBy({ left: -firstSlide.getBoundingClientRect().width });
      }
    });
    next.addEventListener('click', () => {
      if (next.getAttribute('aria-disabled') !== 'true') {
        track.scrollBy({ left: firstSlide.getBoundingClientRect().width });
      }
    });

    track.addEventListener('scroll', updateControls, { passive: true });
    new ResizeObserver(updateControls).observe(track);
    updateControls();
    track.dataset.snap = '';
    controls.hidden = false;
  }
</script>

<style>
  .guest-universities__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .guest-universities__intro h2 {
    font-size: clamp(2.5rem, 1.9rem + 1.8vw, 3.5rem);
  }

  .guest-universities__intro p {
    margin-top: var(--space-4);
    color: var(--ink-2);
  }

  .guest-universities__controls:not([hidden]) {
    display: flex;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  .guest-universities__controls .btn {
    width: 3rem;
    padding-inline: 0;
  }

  .guest-universities__controls .btn[aria-disabled='true'] {
    background: transparent;
    color: var(--ink);
    cursor: default;
  }

  .guest-universities__controls [data-university-previous]:hover :global(svg) {
    transform: translateX(-3px);
  }

  .guest-universities__controls .btn[aria-disabled='true'] :global(svg) {
    transform: none;
  }

  .guest-universities__track {
    --slides-in-view: 1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(100% / var(--slides-in-view));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .guest-universities__track[data-snap] {
    scroll-snap-type: x mandatory;
  }

  .guest-universities__slide {
    display: grid;
    place-items: center;
    min-height: clamp(8rem, 6.5rem + 3vw, 10rem);
    padding: var(--space-5) clamp(var(--space-4), 3vw, var(--space-6));
    background: #fff;
    border-inline-end: 1px solid #d5dfeb;
    scroll-snap-align: start;
  }

  .guest-universities__slide:last-child {
    border-inline-end: 0;
  }

  .guest-universities__slide img {
    width: 100%;
    max-width: 15rem;
    height: 4rem;
    object-fit: contain;
  }

  .guest-universities__slide--compact img {
    max-width: 10rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .guest-universities__track {
      scroll-behavior: smooth;
    }
  }

  @media (min-width: 600px) {
    .guest-universities__track {
      --slides-in-view: 2;
    }
  }

  @media (min-width: 960px) {
    .guest-universities__track {
      --slides-in-view: 3;
    }
  }

  @media (min-width: 1200px) {
    .guest-universities__track {
      --slides-in-view: 4;
    }
  }
</style>
