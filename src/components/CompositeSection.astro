---
// Section A-A through a composite deck: a concrete slab (conscience) tied to
// a steel girder (code) by shear studs, so the two act as one member.
interface Props {
  id?: string;
}
const { id = 'section-aa' } = Astro.props;

const SLAB = { x: 20, y: 52, w: 480, h: 78 };
const CX = SLAB.x + SLAB.w / 2;
const FLANGE_T = { x: CX - 106, y: 130, w: 212, h: 14 };
const WEB = { x: CX - 8, y: 144, w: 16, h: 150 };
const FLANGE_B = { x: CX - 86, y: 294, w: 172, h: 14 };
const studs = [CX - 58, CX, CX + 58];
const rebarTop = Array.from({ length: 10 }, (_, i) => SLAB.x + 24 + i * 48);
const rebarBot = rebarTop;

// Concrete stipple: a fixed scatter of dots and small triangles.
const stipple: string[] = [];
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
for (let i = 0; i < 70; i++) {
  const x = SLAB.x + 8 + rand() * (SLAB.w - 16);
  const y = SLAB.y + 8 + rand() * (SLAB.h - 16);
  if (i % 3 === 0) {
    stipple.push(`M${x.toFixed(1)},${(y - 3).toFixed(1)} l3,5 h-6 z`);
  } else {
    stipple.push(`M${x.toFixed(1)},${y.toFixed(1)} h0.01`);
  }
}
---

<figure class="composite" aria-labelledby={`${id}-cap`}>
  <svg viewBox="0 0 640 380" role="img" aria-labelledby={`${id}-title ${id}-desc`} class="composite__svg">
    <title id={`${id}-title`}>Section A-A: a composite bridge deck</title>
    <desc id={`${id}-desc`}>
      A concrete slab, keynote 1, sits on a steel girder, keynote 3. Shear studs, keynote 2, tie them together so
      they carry load as one member.
    </desc>

    <!-- Slab outline and stipple -->
    <rect class="ln ln--heavy" x={SLAB.x} y={SLAB.y} width={SLAB.w} height={SLAB.h}></rect>
    <path class="stipple" d={stipple.join(' ')}></path>
    {rebarTop.map((x) => <circle class="rebar" cx={x} cy={SLAB.y + 18} r="3.2" />)}
    {rebarBot.map((x) => <circle class="rebar" cx={x} cy={SLAB.y + SLAB.h - 16} r="3.2" />)}

    <!-- Shear studs -->
    {
      studs.map((x) => (
        <g class="stud">
          <rect x={x - 3} y={SLAB.y + SLAB.h - 46} width="6" height="46" />
          <rect x={x - 8} y={SLAB.y + SLAB.h - 50} width="16" height="6" />
        </g>
      ))
    }

    <!-- Steel girder, solid in section -->
    <path
      class="steel"
      d={`M${FLANGE_T.x},${FLANGE_T.y} h${FLANGE_T.w} v${FLANGE_T.h} h-${(FLANGE_T.w - WEB.w) / 2} v${WEB.h} h${(FLANGE_B.w - WEB.w) / 2} v${FLANGE_B.h} h-${FLANGE_B.w} v-${FLANGE_B.h} h${(FLANGE_B.w - WEB.w) / 2} v-${WEB.h} h-${(FLANGE_T.w - WEB.w) / 2} z`}
    ></path>

    <!-- Keynote balloons and leaders -->
    <g class="lead-line">
      <path d={`M${SLAB.x + SLAB.w - 40},${SLAB.y + 30} L548,86 H583`}></path>
      <path d={`M${studs[2] + 8},${SLAB.y + SLAB.h - 46} L548,168 H583`}></path>
      <path d={`M${WEB.x + WEB.w},230 L548,250 H583`}></path>
    </g>
    <g class="key">
      <circle cx="600" cy="86" r="17"></circle>
      <text x="600" y="92" text-anchor="middle">1</text>
      <circle cx="600" cy="168" r="17"></circle>
      <text x="600" y="174" text-anchor="middle">2</text>
      <circle cx="600" cy="250" r="17"></circle>
      <text x="600" y="256" text-anchor="middle">3</text>
    </g>

    <!-- Overall dimension -->
    <g class="dimline">
      <path d={`M${SLAB.x},${SLAB.y - 6} V${SLAB.y - 38} M${SLAB.x + SLAB.w},${SLAB.y - 6} V${SLAB.y - 38}`}></path>
      <path d={`M${SLAB.x + 1},${SLAB.y - 30} H${SLAB.x + SLAB.w - 1}`}></path>
      <path class="arrow" d={`M${SLAB.x + 1},${SLAB.y - 30} l11,-4 v8 z M${SLAB.x + SLAB.w - 1},${SLAB.y - 30} l-11,-4 v8 z`}></path>
    </g>

    <!-- Section title -->
    <g class="title">
      <circle cx={CX - 70} cy="352" r="17"></circle>
      <path d={`M${CX - 87},352 H${CX - 53}`}></path>
      <text x={CX - 70} y="347" text-anchor="middle" class="title__a">A</text>
      <text x={CX - 70} y="368" text-anchor="middle" class="title__a">A</text>
      <text x={CX - 42} y="358" class="title__t">SECTION A-A</text>
    </g>
  </svg>

  <figcaption id={`${id}-cap`}>
    <ol class="keynotes">
      <li><span class="keynotes__n annot is-strong">1</span><span><strong>Conscience.</strong> Who AI serves, who it overlooks, and how it can be redesigned for equity.</span></li>
      <li><span class="keynotes__n annot is-strong">2</span><span><strong>Bonded.</strong> We don’t separate code from conscience.</span></li>
      <li><span class="keynotes__n annot is-strong">3</span><span><strong>Code.</strong> How algorithms work, and why they sometimes fail.</span></li>
    </ol>
  </figcaption>
</figure>

<style>
  .composite {
    margin: 0;
  }

  .composite__svg {
    width: 100%;
    height: auto;
  }

  .ln {
    fill: none;
    stroke: var(--ink);
  }

  .ln--heavy {
    stroke-width: 2.4;
  }

  .stipple {
    fill: none;
    stroke: var(--steel);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rebar {
    fill: var(--ink);
  }

  .stud rect {
    fill: var(--ink);
  }

  .steel {
    fill: var(--ink);
  }

  .lead-line path,
  .dimline path {
    fill: none;
    stroke: var(--steel);
    stroke-width: 1.2;
  }

  .dimline .arrow {
    fill: var(--steel);
    stroke: none;
  }

  .key circle,
  .title circle {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.6;
  }

  .title path {
    stroke: var(--ink);
    stroke-width: 1.2;
  }

  .key text,
  .title text {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-weight: 750;
    font-size: 17px;
  }

  .title .title__a {
    font-size: 13px;
  }

  .title .title__t {
    font-size: 17px;
    letter-spacing: 0.08em;
  }

  .keynotes {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .keynotes li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
  }

  .keynotes__n {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    transform: translateY(0.35rem);
  }
</style>
